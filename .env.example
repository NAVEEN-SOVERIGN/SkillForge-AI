
APP_ORIGIN=http://localhost:5173
APP_ENV=development
SCAN_WORKER_ENABLED=true
# Required in production. Development defaults to a local ignored SQLite file.
DATABASE_URL=
GITHUB_API_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# Optional, used only when the user opts in for a scan.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional until the dedicated judge service is available.
JUDGE_URL=
JUDGE_TOKEN=
JUDGE_CONTAINER_RUNTIME=runsc
JUDGE_PYTHON_IMAGE=
JUDGE_JAVASCRIPT_IMAGE=
# Optional HTTPS Query API. Set URI to Aura's neo4j+s:// host or specify its HTTPS origin.
NEO4J_URI=
NEO4J_QUERY_URL=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
